---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <h1>Penguin avec plusieurs filtres</h1>

  <a href="/">Retour au sommaire</a>

  <p>
    <label for="species">Espèce :</label>

    <select name="species" id="species">
      <option value="">All species</option>
      <option value="Adelie">Adelie</option>
      <option value="Chinstrap">Chinstrap</option>
      <option value="Gentoo">Gentoo</option>
    </select>
  </p>

  <p>
    <label for="island">Île :</label>

    <select name="island" id="island">
      <option value="">All islands</option>
      <option value="Biscoe">Biscoe</option>
      <option value="Dream">Dream</option>
      <option value="Torgersen">Torgersen</option>
    </select>
  </p>

  <p>
    <label for="sex">Sexe :</label>

    <select name="sex" id="sex">
      <option value="">All sexes</option>
      <option value="MALE">MALE</option>
      <option value="FEMALE">FEMALE</option>
    </select>
  </p>

  <div id="myplot"></div>

  <script>
    import * as Plot from "@observablehq/plot";
    import penguins from "../assets/penguins.json";

    const selectSpecies =
      document.querySelector("#species") as HTMLSelectElement;

    const div =
      document.querySelector("#myplot") as HTMLDivElement;

    function renderPlot() {
      const species = selectSpecies.value;

      div.innerHTML = "";

      const filteredPenguins =
        species === ""
          ? penguins
          : penguins.filter((penguin) => penguin.species === species);

      const plot = Plot.plot({
        marks: [
          Plot.dot(filteredPenguins, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
          }),
        ],
      });

      div.append(plot);
    }

    selectSpecies.addEventListener("change", renderPlot);

    renderPlot();
  </script>
</Layout>